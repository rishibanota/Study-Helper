# Copy this to `.env` (or export the vars directly). Never commit real keys.
# The app works with NO keys at all via local + browser fallbacks.

# Primary AI for "simplify this idea" (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional fallback AI (https://pollinations.ai — key is optional)
POLLINATIONS_API_KEY=

# Optional server settings (defaults: PORT=8081, HOST=0.0.0.0)
# PORT=8081
# HOST=0.0.0.0
