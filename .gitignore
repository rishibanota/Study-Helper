# Prevent secrets and bulky generated files from being committed.
node_modules/
.env
.DS_Store

# Pre-generated neural voiceovers are large (~30 MB per voice).
# Only the Emma demo voice is tracked so users can try audio right away.
# Other voices stay ignored; the app falls back to browser speech synthesis
# when mp3s are missing.
public/audio/*
!public/audio/bf_emma/
*.zip
/content/
temp_chunk.wav
